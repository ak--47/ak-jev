{
	"name": "ak-jev",
	"author": "ak@mixpanel.com",
	"description": "AK's wrapper for TypeSafe's Jev — the System One model. Typed decisions, probabilities and confidence for Node.js.",
	"version": "0.1.0",
	"main": "index.js",
	"files": [
		".env.example",
		"CHANGELOG.md",
		"GUIDE.md",
		"LICENSE",
		"RECIPES.md",
		"answers.js",
		"base.js",
		"cache.js",
		"classifier.js",
		"cli.js",
		"client.js",
		"detector.js",
		"errors.js",
		"evaluator.js",
		"extractor.js",
		"governor.js",
		"guard.js",
		"index.cjs",
		"index.js",
		"logger.js",
		"models.js",
		"questions.js",
		"ranker.js",
		"router.js",
		"scorer.js",
		"taxonomy.js",
		"tokens.js",
		"types.d.ts",
		"examples"
	],
	"types": "types.d.ts",
	"bin": {
		"ak-jev": "cli.js"
	},
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"import": {
				"types": "./types.d.ts",
				"default": "./index.js"
			},
			"require": {
				"types": "./types.d.ts",
				"default": "./index.cjs"
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ak--47/ak-jev"
	},
	"bugs": {
		"url": "https://github.com/ak--47/ak-jev/issues"
	},
	"homepage": "https://github.com/ak--47/ak-jev#readme",
	"scripts": {
		"prepublishOnly": "npm run typecheck && npm run build:cjs",
		"post": "npm publish",
		"release": "npm version patch && npm publish --access public",
		"update-deps": "npx npm-check-updates -u && npm install",
		"prune": "rm -rf tmp/*",
		"test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
		"test:live": "JEV_LIVE=1 node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/live",
		"coverage": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
		"build:cjs": "esbuild index.js --bundle --platform=node --format=cjs --outfile=index.cjs --external:dotenv --external:pino --external:pino-pretty",
		"typecheck": "tsc --noEmit",
		"probe-api": "node scripts/probe-api.mjs"
	},
	"type": "module",
	"keywords": [
		"typesafe",
		"jev",
		"system one",
		"ai wrapper",
		"classification",
		"confidence",
		"calibrated",
		"routing",
		"guardrails",
		"reranking",
		"llm"
	],
	"license": "ISC",
	"dependencies": {
		"dotenv": "^17.3.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"esbuild": "^0.27.4",
		"jest": "^30.3.0",
		"typescript": "^5.9.3"
	}
}
