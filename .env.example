# ak-jev configuration
# Copy to .env and fill in. NEVER commit .env.

# Bearer key for the TypeSafe API. Required.
# Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# API root. Optional — defaults to https://api.typesafe.ai
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Default model. Optional — defaults to jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional: set to 1 to run the live test suite (real API calls, well under a cent)
# JEV_LIVE=1

# Optional: pino log level (trace|debug|info|warn|error|fatal|silent)
# LOG_LEVEL=info
