# ak-jev configuration
# Copy to .env and fill in. NEVER commit .env.

# Bearer key for the TypeSafe API. Required, unless JEV_PROVIDER=litellm.
# Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# API root. Optional — defaults to https://api.typesafe.ai
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Default model. Optional — defaults to jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest

# ── Mixpanel's LiteLLM gateway (Kev) ─────────────────────────────────────────
# Set JEV_PROVIDER=litellm to use the gateway instead of TypeSafe. Then only
# LITELLM_API_KEY is required. Create a key at https://litellm.mixpanel.org:
# Virtual Keys, Create Key, team general or sales.
# JEV_PROVIDER=litellm
# LITELLM_API_KEY=sk-...
# Gateway root. Optional; defaults to https://litellm.mixpanel.org. ak-jev adds /typesafe.
# LITELLM_BASE_URL=https://litellm.mixpanel.org

# Optional: set to 1 to run the live test suite (real API calls, well under a cent)
# JEV_LIVE=1

# Optional: pino log level (trace|debug|info|warn|error|fatal|silent)
# LOG_LEVEL=info
